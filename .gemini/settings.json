{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Tick decisions. Query before new tasks.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Tick decisions. Query before new tasks.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Session ending. Tick final decisions and next steps.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Session ending. Tick final decisions and next steps.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cargo run --quiet -- memory start",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "mcpServers": {
    "legend-memory": {
      "args": [
        "run",
        "--quiet",
        "--",
        "mcp-serve"
      ],
      "command": "cargo"
    }
  }
}