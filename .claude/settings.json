{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cargo run --quiet -- memory start",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Session ending. Tick final decisions and next steps.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Session ending. Tick final decisions and next steps.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Tick decisions. Query before new tasks.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "echo \"[Legend] Tick decisions. Query before new tasks.\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}