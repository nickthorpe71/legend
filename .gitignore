/target

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Generated hypergraph snapshots — regenerate via dump_hypergraph_md
/inspect/

# Regeneratable fp32 weights (~86 MB). Used only by the fp32-vs-INT8
# validator behind `--features fp32_reference`. Regenerate via:
#   cargo run --release --example extract_weights --features fp32_reference
models/minilm-fp32.bin

# GLiNER2 fp32 weights (~600 MB). Regenerated via the Python exporter
# in oracle/. Same rationale as MiniLM: feature-gated reference, not
# shipped in production builds.
models/gliner2-fp32.bin

# BGE-small re-export source (~130 MB fp32 safetensors). The runtime uses
# only the quantized blob (minilm.int8.bin) + vocab.txt, both committed.
# Regenerate the blob via tools/embed_prep after fetching the source:
#   curl -sL -o models/bge-small-en-v1.5/model.safetensors \
#     https://huggingface.co/BAAI/bge-small-en-v1.5/resolve/main/model.safetensors
models/bge-small-en-v1.5/model.safetensors

# Python venv + HF model cache used by the GLiNER2 oracle / weight
# exporter. The oracle scripts themselves are tracked.
/oracle/venv/
/oracle/hf_cache/
/oracle/params.json
# Staging location for the fast tokenizer extraction in the exporter.
# The committed copy lives at `models/gliner2-tokenizer/`.
/oracle/tokenizer_pkg/


# Added by cargo
#
# already existing elements were commented out

#/target

# Claude Code local state — local-only, never check in.
.claude/

# Rust build dir for the offline embed-prep tool (regeneratable).
/tools/embed_prep/target/

# C build outputs (built by check.sh) + python bytecode
/legend
/legend.asan
/legend.fuzz
/legend_test
/legend_test.asan
__pycache__/

# Atomic-write tempfiles from `src/persistence.rs`. The actual
# snapshot file `.legend/memory.lz4` IS committed per CLAUDE.md.
.legend/memory.lz4.tmp.*

# Daemon runtime artifacts. Per-process, must not be tracked.
.legend/legend.lock
.legend/legend.port

# LongMemEval bench artifacts — dataset is 15 MB (download from
# the LongMemEval project), verbose dumps are per-run scratch.
benchmarks/longmemeval_oracle.json
benchmarks/last_run_verbose.json
benchmarks/venv/

# Generated corpus ledger (regenerate: python3 harness/record_run.py)
/corpus_run.md

# Generated agentic full-loop ledgers (regenerate: python3 harness/eval_agentic.py)
/agentic_ledger_*.md
/agentic_ledger_*.md.saves.json
/mcp_ledger_*.md

# Local Legend store + generated MCP config (machine-specific; `legend init` recreates both)
/.legend/
/.mcp.json

# Secrets (eval harness API key)
/.env

# viz binary (build with: cc -std=c99 -O2 legend_viz.c embed.c -o legend-viz -lX11 -lm)
/legend-viz
